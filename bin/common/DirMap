#!/usr/bin/env bash
#
# Prints the path to the specified destination.
# Source this script to define a 'goto' function automatically going where asked
# and a 'jumpto' function which also sets a way back with `popd`.
# It also sets completion.
#

if [[ "$(basename -- "$0")" == "DirMap" ]]; then
	Version="1.2"
	ScriptName="$(basename "$0")"
	
	: ${DirMapHelpMessage:="Prints the directory corresponding to the specified key."}
	
	function help() {
		cat <<-EOH
		${DirMapHelpMessage}
		
		Usage:  ${ScriptName}  [options] DirKey [ExtraPath ...]
		
		Options are read from all files in list of directories, in this order:
		../params/dirmap.d , ./dirmap.d, ./params/dirmap.d, ../dirmap.d and
		the content of DIRMAP_MAPS variable (currently: '${DIRMAP_MAPS}'), where
		"." is the directory where the DirMap script resides and the input from
		the later directories overrides the previous.
		If DirKey includes directory separators ('/'), the part following the first
		one is also considered an extra path.
		
		Options:
		--list , -l
		    prints all the possible keys
		--show , -s
		    shows all the paths and their keys
		--verify
		    like '--show', but checks if all the endpoints exist
		--version , -V
		    print the version
		--help , -h , -?
		    print this help message
		
		EOH
	} # help()
	
	function isFlagSet() { local VarName="$1" ; [[ -n "${!VarName//0}" ]] ; }
	function STDERR() { echo "$*" >&2 ; }
	function ERROR() { STDERR "ERROR: $*" ; }
	function FATAL() {
		local Code=$?
		shift
		STDERR "FATAL ERROR(${Code}): $*"
		exit $Code
	} # FATAL
	function PrintColor() {
		# Prints the specified message with the color ANSI code in the first argument
		local Color="$1"
		shift
		if [[ "${UseColor:-1}" != 0 ]]; then
			printf "${Color}${*}\e[0m"
		else
			printf "$*"
		fi
	} # PrintColor()
	
	
	declare DEBUG=0 DoTrace=0 DoHelp=0 DoVersion=0 DoShowKeysMap=0 DoPrintKeysList=0 DoVerify=0 UseColor=0
	[[ -t 1 ]] && UseColor=1 # use color by default only if file descriptor 1 (stdout) is a terminal
	declare DirKey
	declare NoMoreOptions=0
	for ((iParam = 1; iParam <= $# ; ++iParam)); do
		Param="${!iParam}"
		if [[ "${Param:0:1}" != '-' ]] || isFlagSet NoMoreOptions ; then
			if [[ -z "$DirKey" ]]; then
				DirKey="${Param%%/*}"
				[[ "$DirKey" != "$Param" ]] && ExtraPath+="/${Param#*/}"
			else
				ExtraPath+="/${Param#/}"
			fi
		else
			case "$Param" in
				( '--list' | '-l' )
					DoPrintKeysList=1
					;;
				( '--show' | '-s' )
					DoShowKeysMap=1
					;;
				( '--verify' )
					DoShowKeysMap=1
					DoVerify=1
					;;
				( '--dirmap='* )
					DirMap="${Param#--dirmap=}"
					;;
				( '--host='* )
					Host="${Param#--*=}"
					;;
				( '--help' | '-h' | '-?' )
					DoHelp=1
					;;
				( '--version' | '-V' )
					DoVersion=1
					;;
				( '--debug' | '-d' )
					DEBUG=1
					;;
				( '--trace' | '-t' )
					DoTrace=1
					;;
				( '--color' )
					UseColor=1
					;;
				( '--nocolor' | '--no-color')
					UseColor=0
					;;
			esac
		fi
	done
	
	: ${DirMap="$0"}
	: ${Host:="${HOSTNAME:-$(hostname)}"}
	
	if isFlagSet DoVersion ; then
		echo "${ScriptName} ${Version}"
		exit 0
	fi
	
	if isFlagSet DoHelp ; then
		help
		exit 0
	fi
	
	
	#############################################################################
	
	function isDebugging() {
		local Level="${1:-1}"
		[[ -n "$DEBUG" ]] && [[ "$DEBUG" -ge "$Level" ]]
	} # isDebugging()
	
	function DBG() { isDebugging && STDERR "DBG| $*" ; }
	
	function Map() { "$DirMap" "$@" ; }
	
	#############################################################################
	###  Custom functions here
	function GetHome() {
		if [[ -n "${SHORTHOME//0}" ]]; then
			echo "~"
		else
			echo "$HOME"
		fi
	} # GetHome()
	#############################################################################
	
	function GetPathTypeNParams() {
		# Prints the number of parameters index in a specification of type `PathType`
		local PathType="$1"
		local NParams=0
		
		# first determine how many parameters we have, so that we can find where the aliases are
		case "$PathType" in
			( '@path@' ) NParams=2 ;;
			( '@based@' ) NParams=3 ;;
			( '@alias@' ) NParams=2 ;;
			( '@func@' ) NParams=2 ;; # equivalent to '@func0@'
			( '@func'*'@' ) NParams="${PathType#@func}" ; NParams="$(( ${NParams%@} + 2))" ;;
			( * )
				echo "Internal error: path type '${PathType}' in specification '${PathSpecVarName}' not supported" >&2
				return 2
		esac
		echo "$NParams"
		return 0
	} # GetPathTypeNParams()
	
	function GetFirstAliasIndex() {
		# Returns the index of the first alias in the specified specification
		
		local PathSpecVarName="$1"
		# the first alias is after all the parameters, so it has the index of NParams
		GetPathTypeNParams "${!PathSpecVarName[0]}"
		
	} # GetFirstAliasIndex()
	
	function GetNArgs() {
		# assumes a function
		local NParams="$(GetFirstAliasIndex "$1")"
		local ExitCode=$?
		[[ $ExitCode != 0 ]] && exit $ExitCode
		echo "$((NParams - 1))"
	} # GetNArgs()
	
	function PrintPathAliases() {
		local PathSpecVarName="$1"
		
		local iFirstAlias=$(GetFirstAliasIndex "$PathSpecVarName")
		local ExitCode=$?
		[[ $ExitCode != 0 ]] && return $ExitCode
		
		local -a Items
		eval "Items=( \"\${${PathSpecVarName}[@]}\" )"
		printf "%s\n" "${Items[@]:${iFirstAlias}}"
		return 0
	} # PrintPathAliases()
	
	function BuildPath() {
		local PathSpecVarName="$1"
		
		# PathSpec is a copy of the content of the path in PathSpecVarName
		eval 'local -a PathSpec=( "${'${PathSpecVarName}'[@]}" )'
		
		local PathType="${PathSpec[0]}"
		case "$PathType" in
			( '@path@' ) ### a simple path ########################################
				echo "${PathSpec[1]}"
				;;
			
			( '@alias@' ) ### an explicit alias to another path ###################
				FindPath "${PathSpec[1]}"
				ExitCode=$?
				;;
			
			( '@based@' ) ### a path on top of another known path #################
				DBG "Base: '${PathSpec[1]}' + '${PathSpec[2]}'"
				local BasePath="$(FindPath "${PathSpec[1]}")"
				if [[ $? != 0 ]]; then
					echo "Internal error: base path '${PathSpec[1]}' in specification '${PathSpecVarName}' not known" >&2
					BasePath=''
				fi
				local AppendPath="${PathSpec[2]}"
				echo "${BasePath}${AppendPath:+"/${AppendPath}"}"
				;;
			( '@func'*'@' ) ### a function call with * parameters #################
				local iFirstAlias=$(GetFirstAliasIndex "$PathSpecVarName")
				local FunctionName="${PathSpec[1]}"
				local -a FunctionArgs=( "${PathSpec[@]:2:$iFirstAlias - 1}" )
				DBG "Function with $((iFirstAlias-1)) parameters: ${FunctionName}(${FunctionArgs[@]})"
				"$FunctionName" "${FunctionArgs[@]}"
				ExitCode=$?
				;;
		esac
		
		return $ExitCode
	} # BuildPath()
	
	function PresentPath() {
		local PathVarName="$1"
		local Verify="${2:-0}"
		local -i ExitCode=0
		local -a Aliases=( $(PrintPathAliases "$PathVarName") )
		
		[[ ${#Aliases[@]} -gt 0 ]] || return 1
		
		local ExpandedPath="$(BuildPath "$PathVarName")"
		
		local Color
		local Accessible
		if isFlagSet Verify ; then
			if [[ -x "$ExpandedPath" ]] && [[ -d "$ExpandedPath" ]]; then
				Accessible=1
				Color="\e[1;32m"
			else
				Accessible=0
				Color="\e[1;31m"
			fi
			ResetColor="\e[0m"
		fi
		
		PrintColor "$Color" "${Aliases[0]}"
		if isFlagSet Verify && ! isFlagSet Accessible ; then
			echo -n " [NOT ACCESSIBLE]"
			ExitCode=2
		fi
		echo -n "  => '${ExpandedPath}'"
		if [[ ${#Aliases[@]} -gt 1 ]]; then
			echo -n " (also: ${Aliases[1]}"
			printf ", %s" "${Aliases[@]:2}"
			echo -n ")"
		fi
		echo
		return $ExitCode
	} # PresentPath()
	
	
	function FindPath() {
		# Looks up all the entries for `keyword` alias, prints the path of the matched entry
		local keyword="${1,,}"
		DBG "Keyword: '${keyword}'"
		local PathVarName="${PathSpecIndex["$keyword"]}"
		[[ -n "$PathVarName" ]] || return 1
		BuildPath "$PathVarName"
	} # FindPath()
	
	function PresentPaths() {
		local PathVarName
		local Verify="${1:-0}"
		for PathVarName in "${!PathSpec_@}" ; do
			PresentPath "$PathVarName" "$Verify"
		done
	} # PresentPaths()
	
	function PrintNEntries() {
		# Prints the number of entries (does not include implicit aliases).
		local -a PathVarNames
		PathVarNames=( "${!PathSpec_@}" )
		echo "${#PathVarNames[@]}"
	} # PrintNEntries()
	
	function PrintAllAliases() {
		local PathVarName
		for PathVarName in "${!PathSpec_@}" ; do
			PrintPathAliases "$PathVarName" || return 1
		done
		return 0
	} # PrintAllAliases()
	
	function ReloadDirMaps() {
		# Forces the reload of all map entries.
		# 
		# It creates (via `RegisterDirMapEntry()`) a `PathSpec_<keyword>` for each
		# entry in the map, and an entry `PathSpecIndex[<alias>]` for each alias
		# of that entry (including the key).
		#
		# TODO needs some decent error handling...
		
		function GetKeyIndex() {
			# Returns the index of the first alias (= key) of a map entry specification.
			GetPathTypeNParams "$1"
		} # GetKeyIndex()
		
		function RegisterDirMapEntry() {
			local -a Parameters=( "$@" )
			
			local -i KeyIndex
			KeyIndex="$(GetKeyIndex "${Parameters[0]}")"
			[[ $? != 0 ]] && return 1
			
			local Key="${Parameters[$KeyIndex]}"
			local VarName="PathSpec_${Key}"
			eval "${VarName}=( \"\${Parameters[@]}\" ) ; export \"$VarName\""
			
			# update the index
			local Alias
			for Alias in "${Parameters[@]:$KeyIndex}" ; do
				PathSpecIndex["${Alias,,}"]="$VarName"
			done
			
		} # RegisterDirMapEntry()
		
		function LoadDefaultEntries() {
			RegisterDirMapEntry '@func@' 'GetHome' 'home'
		} # LoadDefaultEntries()
		
		function LoadMapFromExecutable() {
			local SourceFile="$1"
			source "$SourceFile"
		} # LoadMapFromExecutable()
		
		function LoadMapFromDataFile() {
			local SourceFile="$1"
			local PathType
			while read -a Items ; do
				PathType="${Items[0]}"
				[[ -n "$PathType" ]] || continue
				[[ "${PathType:0:1}" == '#' ]] && continue
				RegisterDirMapEntry "${Items[@]}"
			done < "$SourceFile"
			
		} # LoadMapFromDataFile()
		
		function LoadMapFromDirectory() {
			local SourceDir="${1:-"."}"
			local SourceFile
			
			for SourceFile in "${SourceDir}/"* ; do
				[[ -e "$SourceFile" ]] || continue
				if [[ -d "$SourceFile" ]]; then
					LoadMapFromDirectory "$SourceFile"
				elif [[ -x "$SourceFile" ]]; then
					LoadMapFromExecutable "$SourceFile"
				else
					LoadMapFromDataFile "$SourceFile"
				fi
			done # SourceFile
		} # LoadMapFromDirectory()
		
		LoadDefaultEntries
		
		local BaseDir="$(dirname "$BASH_SOURCE")"
		# make the path absolute and without '.' and '..' elements
		declare -F canonical_path >& /dev/null && BaseDir="$(canonical_path -a "$BaseDir")"
		local ParentBaseDir="$(dirname "$BaseDir")"
		local -a SourceDirs=(
			"${BaseDir}/params/dirmap.d"
			"${BaseDir}/dirmap.d"
			"${ParentBaseDir}/params/dirmap.d"
			"${ParentBaseDir}/dirmap.d"
			"$DIRMAP_MAPS"
			"$@"
		)
		
		local SourceDir SourceFile
		for SourceDir in "${SourceDirs[@]}" ; do
			[[ -n "$SourceDir" ]] || continue
			LoadMapFromDirectory "$SourceDir"
		done # SourceDir
		
		unset -f LoadMapFromExecutable LoadMapFromDataFile LoadMapFromDirectory
		
	} # ReloadDirMaps()
	
	
	function LoadDirMaps() {
		# Loads the maps only if they haven't been loaded yet.
		areDirMapsLoaded || ReloadDirMaps
	} # LoadDirMaps()
	
	
	function areDirMapsLoaded() {
		# Returns 0 if some maps are loaded
		
		# we assume that there are always default entries in the map
		local -i NEntries
		NEntries=$(PrintNEntries)
		[[ $NEntries -gt 0 ]]
		
	} # areDirMapsLoaded()
	
	
	function CompleteKey() {
		# Prints all the possible completions of the specified keyword, space-separated;
		# an exact match is always printed out first.
		# Returns success (0) if only one key matches;
		# 1 if there are multiple matching keys, 2 if no key matches,
		# 3 if the key stub is not valid
		# 
		
		local key="${1,,}"
		
		local -a MatchedKeys # array variable storing the possible completions
		
		local DirKey
		local ExactMatch # track an exact match, but don't immediately add it
		for DirKey in $(DirMap --list) ; do
			[[ "${DirKey,,}" == ${key} ]]  && ExactMatch="$DirKey"       && continue
			[[ "${DirKey,,}" =~ ^${key} ]] && MatchedKeys+=( "$DirKey" ) && continue
		done
		
		[[ -n "$ExactMatch" ]] && MatchedKeys=( "$ExactMatch" "${MatchedKeys[@]}" )
		[[ "${#MatchedKeys[*]}" -gt 0 ]] && echo "${MatchedKeys[*]}"
		case "${#MatchedKeys[*]}" in
			( 1 )
				return 0
			( 0 )
				return 2
			( * )
				return 1
		esac
	} # CompleteKey()
	
	declare -A PathSpecIndex  # global
	
	declare Keyword="${DirKey%%/*}"
	
	isFlagSet DoTrace && set -x
	if isFlagSet DoPrintKeysList ; then
		LoadDirMaps
		PrintAllAliases
		exit $?
	fi
	
	if isFlagSet DoShowKeysMap ; then
		LoadDirMaps
		PresentPaths "$DoVerify"
		exit $?
	fi
	
	if [[ -z "$DirKey" ]]; then
		help
		FATAL 1 "Need to specify a directory key."
	fi
	
	LoadDirMaps
	
	declare Path
	Path="$(isFlagSet DoTrace && set -x ; FindPath "$Keyword")"
	ExitCode=$?
	if [[ $ExitCode != 0 ]]; then
		echo "Path to '${Keyword}' not known." >&2
		exit 1
	fi
	
	echo "${Path}${ExtraPath}"
	set +x
	
else
	function goto() {
		local DestDir="$(DirMap "$@")"
		if [[ -d "$DestDir" ]]; then
			cd "$DestDir"
		elif [[ -n "$DestDir" ]]; then
			echo "Directory '${DestDir}' does not exist." >&2
		fi
	}

	function jumpto() {
		local DestDir="$(DirMap "$@")"
		if [[ -d "$DestDir" ]]; then
			pushd "$DestDir" > /dev/null
		elif [[ -n "$DestDir" ]]; then
			echo "Directory '${DestDir}' does not exist." >&2
		fi
	}
	
	
	function DirMapCompleteKey() {
		# completion of the keyword mentioned: prints the matches, space-separated;
		# an exact match is always printed out first.
		# Returns success (0) if only one key matches;
		# 1 if there are multiple matching keys, 2 if no key matches,
		# 3 if the key stub is not valid
		# 
		# Gets the full map keys from `DirMap --list`.
		# 
		
		local key="${1,,}"
		
		local -a MatchedKeys # array variable storing the possible completions
		
		local DirKey
		local ExactMatch # track an exact match, but don't immediately add it
		for DirKey in $(DirMap --list) ; do
			[[ "${DirKey,,}" == ${key} ]]  && ExactMatch="$DirKey"       && continue
			[[ "${DirKey,,}" =~ ^${key} ]] && MatchedKeys+=( "$DirKey" ) && continue
		done
		
		[[ -n "$ExactMatch" ]] && MatchedKeys=( "$ExactMatch" "${MatchedKeys[@]}" )
		[[ "${#MatchedKeys[*]}" -gt 0 ]] && echo "${MatchedKeys[*]}"
		case "${#MatchedKeys[*]}" in
			( 1 )
				return 0
			( 0 )
				return 2
			( * )
				return 1
		esac
	} # DirMapCompleteKey()
	
	
	function _BashCompletion_DirMap() {
		# auto-completion of the thing being set up;
		# choice among the candidates in the blessed directories
		
		local Cur="${COMP_WORDS[COMP_CWORD]}"
		COMPREPLY=( $(DirMapCompleteKey "$Cur") )
		return 0
		
	} # _BashCompletion_DirMap()
	
	complete -F _BashCompletion_DirMap DirMap goto jumpto DirMapCompleteKey
	
fi
